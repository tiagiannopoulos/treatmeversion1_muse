# copy to .env and fill in. never commit real keys.

# supabase (public, safe for the browser bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# supabase (server only, keep secret)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# gemini (server only, keep secret)
# when missing, POST /api/analyze returns 503 "analysis unavailable"
GEMINI_API_KEY=
# optional model override (default: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash
